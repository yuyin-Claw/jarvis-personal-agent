# macOS
.DS_Store

# Node
node_modules/
dist/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]

# 环境与凭证（凭证只入系统 Secret Service，不入仓库）
.env
.env.*
*.key
*.pem

# 日志与本地数据
logs/
*.log
.local/

# 编译产物（macOS 原生宿主二进制，由验收脚本现场编译）
apps/avatar/jarvis-avatar
packages/voice/native/jarvis-speech

# 编辑器
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# WorkBuddy 工作区记忆（本地协作产物，不入公开仓库）
.workbuddy/
dist/
node_modules/
*.tsbuildinfo
# 防止编译产物误入 src（tsc 偶发把 dist 写进源目录）
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts.map
